<launch>
<!-- Launch file for Livox AVIA LiDAR -->

	<arg name="rviz" default="true" />
	<arg name="camera_config" default="$(find fast_livo)/config/camera_NTU_VIRAL.yaml" />

	<rosparam command="load" file="$(find fast_livo)/config/NTU_VIRAL.yaml" />

	<node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen" args="-camera_config $(arg camera_config)"/>
	
	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/ntu_viral.rviz" />
	</group>
</launch> 	
